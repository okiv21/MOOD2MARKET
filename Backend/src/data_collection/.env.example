# Copy this file to ".env" and fill in your own credentials.
# The real .env is git-ignored and must never be committed.

# Reddit API (PRAW) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=Mood2MarketApp

# NewsAPI — https://newsapi.org/ (optional)
NEWS_API_KEY=your_newsapi_key

# Data Collection Settings
START_DATE=2026-01-06
END_DATE=2026-03-05
CRYPTO_SYMBOL=BTCUSDT

# Model Training Settings
LSTM_LOOKBACK=60
TCN_LOOKBACK=60
TRAIN_TEST_SPLIT=0.8
